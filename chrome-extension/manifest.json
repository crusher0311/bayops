{
  "manifest_version": 3,
  "name": "BayOPS Parts & Labor Connector",
  "version": "2.0.0",
  "description": "Connect BayOPS repair orders with PartsTech, ProDemand, AllData, and Identifix",
  "permissions": [
    "storage",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "https://app.partstech.com/*",
    "https://*.partstech.com/*",
    "https://prodemand.com/*",
    "https://*.prodemand.com/*",
    "https://my.alldata.com/*",
    "https://*.alldata.com/*",
    "https://www.identifix.com/*",
    "https://*.identifix.com/*",
    "http://localhost:5000/*",
    "https://*.replit.app/*",
    "https://*.replit.dev/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://app.partstech.com/*", "https://*.partstech.com/*"],
      "js": ["content-partstech.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://prodemand.com/*", "https://*.prodemand.com/*"],
      "js": ["content-prodemand.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://my.alldata.com/*", "https://*.alldata.com/*"],
      "js": ["content-alldata.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.identifix.com/*", "https://*.identifix.com/*"],
      "js": ["content-identifix.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://localhost:5000/*", "https://*.replit.app/*", "https://*.replit.dev/*"],
      "js": ["content-bayops.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "externally_connectable": {
    "matches": ["http://localhost:5000/*", "https://*.replit.app/*", "https://*.replit.dev/*"]
  },
  "web_accessible_resources": [
    {
      "resources": ["injected-bayops.js"],
      "matches": ["http://localhost:5000/*", "https://*.replit.app/*", "https://*.replit.dev/*"]
    },
    {
      "resources": ["injected-partstech.js"],
      "matches": ["https://*.partstech.com/*"]
    }
  ]
}
